\begin{lstlisting}[language=Python, caption={CDKTF Stack --- GKE Cluster Definition}] Example structure — replace with your actual code
from constructs import Construct
from cdktf import App, TerraformStack
from cdktf_cdktf_provider_google.provider import GoogleProvider
from cdktf_cdktf_provider_google.container_cluster import ContainerCluster

class GKEStack(TerraformStack):
    def __init__(self, scope: Construct, id: str):
        super().__init__(scope, id)

        GoogleProvider(self, "google",
            project="your-project-id",
            region="europe-north1"
        )

        ContainerCluster(self, "dagster-cluster",
            name="dagster-gke",
            location="europe-north1-a",
            initial_node_count=1,
            # ... additional configuration
        )

app = App()
GKEStack(app, "dagster-gke-stack")
app.synth()
\end{lstlisting}

