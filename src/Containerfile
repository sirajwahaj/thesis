# Dagster workload container
# Python 3.13-slim matches the uv.lock requires-python = ">=3.13" (dagster 1.12.22)
FROM python:3.13.3-slim

# Set working directory
WORKDIR /opt/dagster/app

# Copy pyproject.toml and uv.lock first (for dependency installation)
COPY pyproject.toml uv.lock ./

# Install uv and create virtual environment
RUN pip install --no-cache-dir uv
RUN uv venv
# Activate the virtual environment for all subsequent RUNs
ENV VIRTUAL_ENV=/opt/dagster/app/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Install dependencies into the virtual environment
RUN uv sync --frozen
RUN uv pip install .

# Copy workload code
COPY workload/ ./workload/

# Set environment variables
ENV DAGSTER_HOME=/opt/dagster/dagster_home
ENV WORKLOAD_DURATION_SECONDS=30

# Create non-root user for security
RUN useradd -m -u 1000 dagster && \
    mkdir -p $DAGSTER_HOME && \
    chown -R dagster:dagster /opt/dagster

# Copy Dagster config files
COPY --chown=dagster:dagster dagster.yaml $DAGSTER_HOME/dagster.yaml
COPY --chown=dagster:dagster workspace.yaml $DAGSTER_HOME/workspace.yaml

# Switch to non-root user
USER dagster

# Expose gRPC port
EXPOSE 4000

# Default command: start Dagster gRPC server
CMD ["dagster", "api", "grpc", "-h", "0.0.0.0", "-p", "4000", "-m", "workload"]