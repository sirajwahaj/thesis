# Environment variables for docker-compose (infrastructure/docker-compose.yml)
# Copy this file to infrastructure/.env and adjust values as needed.
# Defaults are used if variables are not set.

DAGSTER_PG_USERNAME=dagster
DAGSTER_PG_PASSWORD=dagster
DAGSTER_PG_DB=dagster

